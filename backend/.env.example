DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
MAX_GPS_ACCURACY_METERS=150

# Console emails require no setup but do not arrive in inboxes.
# For real delivery, change EMAIL_BACKEND to django.core.mail.backends.smtp.EmailBackend
# and supply your mail provider's SMTP details privately in backend/.env.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=attendance@localhost
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10
PUBLIC_FRONTEND_URL=http://localhost:5173
ATTENDANCE_EMAIL_TIME_ZONE=Africa/Lagos
